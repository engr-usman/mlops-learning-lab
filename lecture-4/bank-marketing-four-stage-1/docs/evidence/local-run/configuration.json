{
  "project": {
    "name": "bank-marketing",
    "random_state": 42
  },
  "data": {
    "path": "data/balance.csv",
    "target": "y",
    "target_values": [
      "yes",
      "no"
    ],
    "positive_label": "yes",
    "features": [
      "age",
      "job",
      "marital",
      "education",
      "default",
      "balance",
      "housing",
      "loan",
      "contact",
      "day",
      "month",
      "duration",
      "campaign",
      "pdays",
      "previous",
      "poutcome"
    ],
    "categorical_features": [
      "job",
      "marital",
      "education",
      "default",
      "housing",
      "loan",
      "contact",
      "month",
      "poutcome"
    ],
    "numeric_features": [
      "age",
      "balance",
      "day",
      "duration",
      "campaign",
      "pdays",
      "previous"
    ]
  },
  "training": {
    "test_size": 0.2
  },
  "evaluation": {
    "minimum_accuracy": 0.7,
    "selection_metric": "f1_score"
  },
  "mlflow": {
    "tracking_uri": "http://127.0.0.1:5001",
    "experiment_name": "bank-marketing-pipeline",
    "registered_model_name": "bank-marketing-pipeline-model"
  },
  "models": {
    "logistic_regression": {
      "max_iter": 1000
    },
    "decision_tree": {
      "criterion": "gini",
      "max_depth": 3,
      "min_samples_split": 2
    },
    "random_forest": {
      "n_estimators": 100,
      "max_depth": null,
      "min_samples_split": 2
    },
    "gradient_boosting": {
      "n_estimators": 100,
      "learning_rate": 0.1,
      "max_depth": 3
    }
  }
}